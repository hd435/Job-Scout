# Copy this file to .env and replace the placeholder values.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Real environment variables
# override the values in .env if both are present.
#
# JOBSCOUT_TELEGRAM_TOKEN    Create a bot with @BotFather in Telegram and copy
#                            the token it gives you (looks like 123456789:AA...).
# JOBSCOUT_TELEGRAM_CHAT_ID  Your numeric chat id. Send any message to your bot,
#                            then read https://api.telegram.org/bot<token>/getUpdates
#                            and look for "chat": {"id": ...}. Group ids are negative.

JOBSCOUT_TELEGRAM_TOKEN=your-bot-token-from-botfather
JOBSCOUT_TELEGRAM_CHAT_ID=your-chat-id
