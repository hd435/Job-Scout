# Job-Scout hosted deployment environment. Root-owned, mode 600, read by systemd only.
#
# NEVER commit a real token. Copy this file to /etc/jobscout/jobscout.env and edit it there:
#   sudo install -o root -g root -m 0600 /opt/jobscout/deploy/oracle/jobscout.env.example \
#     /etc/jobscout/jobscout.env
#   sudoedit /etc/jobscout/jobscout.env

# From @BotFather, shaped like 123456789:AA... — the only credential the service needs.
JOBSCOUT_TELEGRAM_TOKEN=REPLACE_ME

# Where the database lives. On the VM this is the attached boot/block volume; the default in the
# shipped config points at /data, which does not exist here.
JOBSCOUT_DATABASE=/srv/jobscout/data/service.db

# The employer selection for this deployment (D-094, D-100).
JOBSCOUT_CONFIG=/etc/jobscout/service-config.toml

# Optional: an Object Storage bucket for off-VM backups. Leave empty to keep backups local.
JOBSCOUT_BACKUP_BUCKET=
